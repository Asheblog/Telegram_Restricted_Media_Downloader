+name: Verify Branch Build
+
+# 一次性验证工作流：只在指定验证分支上运行，用于在真实 Docker 里验证分支改动
+# （镜像构建、容器内资源布局），避免为了验证去改 release_docker.yml 的触发条件。
+# release_docker.yml 的镜像 tag 取自 GITHUB_REF_NAME，分支名含 "/" 会得到非法 tag，
+# 因此验证分支名必须无斜杠。验证通过后本文件删除。
+on:
+  push:
+    branches: ['verify-decouple']
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+env:
+  IMAGE_NAME: ghcr.io/asheblog/telegram_restricted_media_downloader
+
+jobs:
+  test:
+    runs-on: ubuntu-latest
+    timeout-minutes: 20
+    steps:
+      - name: Checkout repository
+        uses: actions/checkout@v6
+      - name: Set up Python
+        uses: actions/setup-python@v5
+        with:
+          python-version-file: .python-version
+      - name: Install uv
+        uses: astral-sh/setup-uv@v5
+        with:
+          enable-cache: true
+          cache-dependency-glob: |
+            uv.lock
+            pyproject.toml
+      - name: Install dependencies
+        run: uv sync --locked --group dev
+      - name: Run test suite
+        run: uv run --locked pytest -q
+
+  build:
+    needs: [test]
+    runs-on: ubuntu-latest
+    steps:
+      - name: Checkout repository
+        uses: actions/checkout@v6
+      - name: Set up Docker Buildx
+        uses: docker/setup-buildx-action@v3
+      - name: Build image locally (不推送)
+        uses: docker/build-push-action@v5
+        with:
+          context: .
+          push: false
+          load: true
+          platforms: linux/amd64
+          tags: trmd-verify:branch
+          cache-from: type=gha
+          cache-to: type=gha,mode=max
+      # 关键断言：镜像里必须能真正提供 WebUI 资源。
+      # build 阶段会生成 dist/webui/ 并删掉 templates/ static/ build_frontend.py，
+      # 因此这一步会抓住"生成失败/路径写错/删错文件"，这些在本地无法验证。
+      - name: Assert WebUI assets are servable inside the image
+        run: |
+          set -euo pipefail
+          docker run --rm --entrypoint python trmd-verify:branch - <<'PY'
+          import json
+          import pathlib
+          import sys
+
+          sys.path.insert(0, "/app")
+          from module.adapters.webui import static_assets as sa
+
+          assert sa.BUNDLE_FILE.is_file(), f"缺少构建产物: {sa.BUNDLE_FILE}"
+          html = sa.WEB_UI_HTML
+          assert len(html) > 100_000, f"桌面 HTML 过小: {len(html)}"
+          assert "<!doctype html>" in html.lower(), "桌面 HTML 结构异常"
+          mobile = sa.WEB_UI_MOBILE_HTML
+          login = sa.LOGIN_PAGE_HTML
+          assert len(mobile) > 50_000 and len(login) > 10_000, (len(mobile), len(login))
+          names = sa.font_names()
+          assert len(names) >= 13, f"字体数量异常: {names}"
+          raw = sa.load_font(names[0])
+          assert raw and len(raw) > 100, "字体读取失败"
+          # 源文件应已被裁剪（否则镜像多带一份等价内容）
+          assert not (pathlib.Path("/app/module/adapters/webui/templates")).exists(), "templates 未裁剪"
+          assert not (pathlib.Path("/app/module/adapters/webui/static")).exists(), "static 未裁剪"
+          print(json.dumps({
+              "desktop": len(html), "mobile": len(mobile), "login": len(login),
+              "fonts": len(names), "font_bytes": len(raw),
+          }, ensure_ascii=False))
+          PY
